# --- Python ---
# Virtual environments
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.cache
.pytest_cache/
.hypothesis/

# --- Project Specific ---
# Assets nested git repos
# Игнорировать все файлы внутри assets/
assets/**/*

# Обязательно сначала разрешаем все директории
# Без этой строки Git НИКОГДА не будет проверять правила внутри игнорированных папок
!assets/**/

# А потом разрешаем только .gitkeep файлы на любом уровне
!assets/**/.gitkeep

# HSM (Hyper Stack Manager) artifacts
.hpm/
.hsm/
hsm/

# Services
services/

# Memory Bank & Rules
.kilocode/

# Environment files
.env
.env.local
.env.*.local

# Temporary review and agent-generated reports
tmp/

# --- OS / IDE ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, etc.)
.idea/
